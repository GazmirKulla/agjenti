NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Instagram API with Instagram Login (Instagram App ID, jo Facebook App ID)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_API_VERSION=v26.0
INSTAGRAM_OAUTH_REDIRECT_URI=https://agjenti.app/api/instagram/oauth/callback
# Meta Dashboard also needs:
# Deauthorize: https://agjenti.app/api/meta/deauthorize
# Data deletion: https://agjenti.app/api/meta/data-deletion

# Meta webhook
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

TOKEN_ENCRYPTION_KEY=
OPENAI_API_KEY=
# Must match Supabase Vault secret agjenti_cron_secret for the workflow worker.
CRON_SECRET=
AGENT_MODEL=
# Audio onboarding: transcription model + optional structured extraction override
ONBOARDING_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Blank uses AGENT_MODEL / the existing default
ONBOARDING_EXTRACTION_MODEL=
# Business classification; blank uses AGENT_MODEL.
BUSINESS_DISCOVERY_MODEL=
# Must support Responses image inputs + strict JSON Schema; blank uses AGENT_MODEL.
BUSINESS_VISION_MODEL=

# Optional Google Calendar integration (enable Calendar API in Google Cloud)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://agjenti.app/api/calendar/google/callback

# Shared workflow pilot: comma-separated business UUIDs. Empty keeps legacy behavior.
# Apply preceding migrations plus 20261010143000, 20261010150000,
# 20261010213000 and 20261010220000 before enabling message-centered workflows.
# Configure Vault and pg_cron/pg_net with supabase/operations/workflow-worker-schedule.sql.
# Publishing v2 also requires a successful worker heartbeat within the last 3 minutes.
SHARED_WORKFLOW_BUSINESS_IDS=
