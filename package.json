{
  "name": "agjenti.app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev --turbopack --port 3003",
    "build": "next build",
    "start": "next start --port 3003",
    "lint": "eslint",
    "test": "vitest run",
    "e2e:up": "node e2e/local.mjs up && node e2e/fixtures.mjs",
    "e2e:transport": "node e2e/transport.mjs",
    "e2e:app": "node e2e/local.mjs app",
    "e2e:test": "playwright test --config e2e/playwright.config.mjs",
    "e2e:isolation": "node --test e2e/*.test.mjs",
    "e2e:down": "node e2e/local.mjs down"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^15.5.9",
    "openai": "^7.26.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "supabase": "2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
